# ========================================================
# INTERVIX AI - Backend Server Environment Configuration
# ========================================================
# Duplicate this file as .env in the server directory:
# cp .env.example .env

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/intervix_ai

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# AI LLM Provider Configuration (Optional)
# If left blank, INTERVIX AI automatically uses its built-in
# strict semantic rubric evaluator with Hinglish normalization.
# To enable dynamic live Gemini generation, add your API key:
GEMINI_API_KEY=

# Alternatively, configure OpenAI:
OPENAI_API_KEY=
